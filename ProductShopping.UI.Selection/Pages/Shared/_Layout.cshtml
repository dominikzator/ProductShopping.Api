@using Microsoft.Extensions.Options
@inject IOptions<FrontendLinksOptions> LinksOptions
@{
    var links = LinksOptions.Value;
    var cssVersion = File.GetLastWriteTimeUtc(typeof(Program).Assembly.Location).Ticks;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ProductShopping by Dominik Zator — an e-commerce platform with two .NET front-ends: Razor Pages and Blazor." />
    <title>@(ViewData["Title"] is string title ? $"{title} · " : "")ProductShopping by Dominik Zator</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css?v=@cssVersion" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232563eb'/%3E%3Cpath d='M7 9h2.5l2.4 10.5a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.7L25 13H11' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='13.5' cy='24' r='1.6' fill='white'/%3E%3Ccircle cx='21.5' cy='24' r='1.6' fill='white'/%3E%3C/svg%3E" />
</head>
<body>
    <header class="topbar">
        <div class="topbar__inner">
            <a href="/" class="brand" aria-label="ProductShopping by Dominik Zator — home">
                <span class="brand__mark" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="20" r="1.6" />
                        <circle cx="18" cy="20" r="1.6" />
                        <path d="M3 4h2l2.2 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.7L21 8H7" />
                    </svg>
                </span>
                <span class="brand__text">
                    <span class="brand__name">Product<span>Shopping</span></span>
                    <span class="brand__author">by Dominik Zator</span>
                </span>
            </a>

            @if (!string.IsNullOrWhiteSpace(links.SourceCodeUrl))
            {
                <a href="@links.SourceCodeUrl" class="topbar__link" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" />
                    </svg>
                    <span>Source code</span>
                </a>
            }
        </div>
    </header>

    <main class="page">
        @RenderBody()
    </main>

    <footer class="footer">
        <span>© @DateTime.UtcNow.Year Dominik Zator · ProductShopping</span>
        <span class="footer__stack">ASP.NET Core · .NET 8 · REST API · Stripe</span>
    </footer>
</body>
</html>
