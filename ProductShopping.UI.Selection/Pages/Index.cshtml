@page
@model IndexModel
@{
    ViewData["Title"] = "Choose your front-end";
}

<section class="intro">
    <span class="intro__eyebrow">E-commerce platform</span>
    <h1 class="intro__title">One shop. Two <span>.NET front-ends.</span></h1>
    <p class="intro__lead">
        ProductShopping is a .NET e-commerce platform with two independent web front-ends
        built on the same REST API. Pick a technology to start shopping.
    </p>
</section>

<section class="panels" aria-label="Choose a front-end">

    <a class="panel panel--razor" href="@Model.Links.RazorPagesUrl" aria-label="Open the Razor Pages version of ProductShopping">
        <div class="panel__art" aria-hidden="true">
            <svg class="art" viewBox="0 0 520 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- background grid dots -->
                <g opacity=".18" fill="#fff">
                    <circle cx="40" cy="40" r="2" /><circle cx="80" cy="40" r="2" /><circle cx="120" cy="40" r="2" />
                    <circle cx="40" cy="80" r="2" /><circle cx="80" cy="80" r="2" /><circle cx="440" cy="250" r="2" />
                    <circle cx="480" cy="250" r="2" /><circle cx="480" cy="210" r="2" /><circle cx="440" cy="210" r="2" />
                </g>

                <!-- server -->
                <g class="art__server">
                    <rect x="34" y="92" width="112" height="132" rx="14" fill="#fff" fill-opacity=".14" stroke="#fff" stroke-opacity=".55" stroke-width="2" />
                    <rect x="50" y="110" width="80" height="24" rx="6" fill="#fff" fill-opacity=".22" />
                    <rect x="50" y="146" width="80" height="24" rx="6" fill="#fff" fill-opacity=".22" />
                    <rect x="50" y="182" width="80" height="24" rx="6" fill="#fff" fill-opacity=".22" />
                    <circle cx="62" cy="122" r="4" fill="#5eead4" class="art__led" />
                    <circle cx="62" cy="158" r="4" fill="#5eead4" class="art__led art__led--2" />
                    <circle cx="62" cy="194" r="4" fill="#5eead4" class="art__led art__led--3" />
                    <rect x="74" y="119" width="44" height="6" rx="3" fill="#fff" fill-opacity=".6" />
                    <rect x="74" y="155" width="36" height="6" rx="3" fill="#fff" fill-opacity=".6" />
                    <rect x="74" y="191" width="40" height="6" rx="3" fill="#fff" fill-opacity=".6" />
                    <text x="90" y="250" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#fff" fill-opacity=".85">ASP.NET Core</text>
                </g>

                <!-- request / response arrows -->
                <g stroke="#fff" stroke-width="2.5" stroke-linecap="round">
                    <path class="art__flow" d="M156 140 H 222" stroke-dasharray="6 8" stroke-opacity=".9" />
                    <path d="M214 132 l10 8 -10 8" fill="none" stroke-opacity=".9" />
                    <path class="art__flow art__flow--back" d="M222 178 H 156" stroke-dasharray="6 8" stroke-opacity=".55" />
                    <path d="M164 170 l-10 8 10 8" fill="none" stroke-opacity=".55" />
                </g>
                <text x="189" y="126" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" fill="#fff" fill-opacity=".9">HTML</text>
                <text x="189" y="202" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" fill="#fff" fill-opacity=".6">GET / POST</text>

                <!-- browser window with rendered page -->
                <g class="art__browser">
                    <rect x="236" y="54" width="250" height="196" rx="14" fill="#fff" />
                    <rect x="236" y="54" width="250" height="30" rx="14" fill="#e0f2fe" />
                    <rect x="236" y="70" width="250" height="14" fill="#e0f2fe" />
                    <circle cx="254" cy="69" r="4.5" fill="#f87171" />
                    <circle cx="270" cy="69" r="4.5" fill="#fbbf24" />
                    <circle cx="286" cy="69" r="4.5" fill="#34d399" />
                    <rect x="302" y="63" width="160" height="12" rx="6" fill="#fff" />

                    <rect x="254" y="100" width="120" height="12" rx="6" fill="#1e3a8a" fill-opacity=".85" />
                    <rect x="254" y="120" width="180" height="7" rx="3.5" fill="#94a3b8" fill-opacity=".6" />

                    <g class="art__cards">
                        <rect x="254" y="140" width="66" height="88" rx="8" fill="#eff6ff" stroke="#bfdbfe" />
                        <rect x="262" y="148" width="50" height="38" rx="5" fill="#93c5fd" />
                        <rect x="262" y="194" width="40" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="262" y="206" width="26" height="8" rx="4" fill="#0ea5e9" />

                        <rect x="328" y="140" width="66" height="88" rx="8" fill="#eff6ff" stroke="#bfdbfe" />
                        <rect x="336" y="148" width="50" height="38" rx="5" fill="#7dd3fc" />
                        <rect x="336" y="194" width="44" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="336" y="206" width="26" height="8" rx="4" fill="#0ea5e9" />

                        <rect x="402" y="140" width="66" height="88" rx="8" fill="#eff6ff" stroke="#bfdbfe" />
                        <rect x="410" y="148" width="50" height="38" rx="5" fill="#a5b4fc" />
                        <rect x="410" y="194" width="36" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="410" y="206" width="26" height="8" rx="4" fill="#0ea5e9" />
                    </g>
                </g>

                <!-- razor at-sign badge + code snippet -->
                <g class="art__badge">
                    <circle cx="470" cy="56" r="30" fill="#0f172a" />
                    <circle cx="470" cy="56" r="30" stroke="#5eead4" stroke-width="2.5" />
                    <text x="470" y="68" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="34" fill="#5eead4">@@</text>
                </g>
                <g class="art__code">
                    <rect x="196" y="226" width="168" height="56" rx="10" fill="#0f172a" fill-opacity=".92" />
                    <text x="210" y="249" font-family="JetBrains Mono, monospace" font-size="12" fill="#5eead4">@@page</text>
                    <text x="210" y="269" font-family="JetBrains Mono, monospace" font-size="12" fill="#e2e8f0">@@model <tspan fill="#7dd3fc">ProductsModel</tspan></text>
                </g>
            </svg>
        </div>

        <div class="panel__body">
            <span class="panel__tag">ASP.NET Core · Server-side</span>
            <h2 class="panel__title">Razor Pages</h2>
            <p class="panel__text">
                A classic page-based web app. Every page is rendered on the server by a PageModel
                and delivered to the browser as ready-to-use HTML.
            </p>
            <ul class="panel__chips">
                <li>Server-side rendering</li>
                <li>PageModel per page</li>
                <li>Cookie authentication</li>
                <li>Partial views</li>
            </ul>
            <span class="panel__cta">
                Open Razor Pages shop
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
        </div>
    </a>

    <a class="panel panel--blazor" href="@Model.Links.BlazorUrl" aria-label="Open the Blazor version of ProductShopping">
        <div class="panel__art" aria-hidden="true">
            <svg class="art" viewBox="0 0 520 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g opacity=".18" fill="#fff">
                    <circle cx="400" cy="36" r="2" /><circle cx="440" cy="36" r="2" /><circle cx="480" cy="36" r="2" />
                    <circle cx="440" cy="76" r="2" /><circle cx="480" cy="76" r="2" /><circle cx="40" cy="250" r="2" />
                    <circle cx="80" cy="250" r="2" /><circle cx="40" cy="210" r="2" />
                </g>

                <!-- browser window with components -->
                <g class="art__browser">
                    <rect x="34" y="54" width="262" height="200" rx="14" fill="#fff" />
                    <rect x="34" y="54" width="262" height="30" rx="14" fill="#ede9fe" />
                    <rect x="34" y="70" width="262" height="14" fill="#ede9fe" />
                    <circle cx="52" cy="69" r="4.5" fill="#f87171" />
                    <circle cx="68" cy="69" r="4.5" fill="#fbbf24" />
                    <circle cx="84" cy="69" r="4.5" fill="#34d399" />
                    <rect x="100" y="63" width="170" height="12" rx="6" fill="#fff" />

                    <!-- NavMenu component -->
                    <rect x="50" y="96" width="230" height="26" rx="7" fill="#f5f3ff" stroke="#c4b5fd" stroke-dasharray="4 3" />
                    <rect x="60" y="105" width="54" height="8" rx="4" fill="#512bd4" fill-opacity=".85" />
                    <g class="art__cart">
                        <rect x="232" y="102" width="38" height="14" rx="7" fill="#512bd4" />
                        <text x="251" y="113" text-anchor="middle" font-family="Inter, sans-serif" font-weight="700" font-size="10" fill="#fff">3</text>
                    </g>

                    <!-- ProductCard components -->
                    <g class="art__tile art__tile--1">
                        <rect x="50" y="132" width="70" height="104" rx="8" fill="#f5f3ff" stroke="#c4b5fd" stroke-dasharray="4 3" />
                        <rect x="58" y="140" width="54" height="44" rx="5" fill="#c4b5fd" />
                        <rect x="58" y="192" width="42" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="58" y="214" width="54" height="14" rx="7" fill="#7c3aed" />
                    </g>
                    <g class="art__tile art__tile--2">
                        <rect x="130" y="132" width="70" height="104" rx="8" fill="#f5f3ff" stroke="#c4b5fd" stroke-dasharray="4 3" />
                        <rect x="138" y="140" width="54" height="44" rx="5" fill="#ddd6fe" />
                        <rect x="138" y="192" width="46" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="138" y="214" width="54" height="14" rx="7" fill="#7c3aed" />
                    </g>
                    <g class="art__tile art__tile--3">
                        <rect x="210" y="132" width="70" height="104" rx="8" fill="#f5f3ff" stroke="#c4b5fd" stroke-dasharray="4 3" />
                        <rect x="218" y="140" width="54" height="44" rx="5" fill="#a78bfa" />
                        <rect x="218" y="192" width="38" height="6" rx="3" fill="#334155" fill-opacity=".7" />
                        <rect x="218" y="214" width="54" height="14" rx="7" fill="#7c3aed" />
                    </g>
                </g>

                <!-- SignalR connection -->
                <path d="M300 154 C 336 120, 362 190, 396 154" stroke="#fff" stroke-opacity=".35" stroke-width="10" stroke-linecap="round" />
                <path class="art__signal" d="M300 154 C 336 120, 362 190, 396 154" stroke="#fde68a" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 10" />
                <g class="art__bolt">
                    <circle cx="348" cy="154" r="20" fill="#0f172a" />
                    <path d="M352 140 l-12 17 h9 l-4 13 13-18 h-9 z" fill="#fde68a" />
                </g>
                <text x="348" y="200" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" fill="#fff" fill-opacity=".9">SignalR</text>

                <!-- server with component tree -->
                <g class="art__server">
                    <rect x="402" y="92" width="96" height="124" rx="14" fill="#fff" fill-opacity=".14" stroke="#fff" stroke-opacity=".55" stroke-width="2" />
                    <rect x="438" y="106" width="24" height="16" rx="4" fill="#fff" fill-opacity=".85" />
                    <path d="M450 122 v12 M424 134 h52 M424 134 v10 M450 134 v10 M476 134 v10" stroke="#fff" stroke-opacity=".7" stroke-width="2" />
                    <rect x="414" y="144" width="20" height="14" rx="4" fill="#fff" fill-opacity=".55" />
                    <rect x="440" y="144" width="20" height="14" rx="4" fill="#fde68a" class="art__node" />
                    <rect x="466" y="144" width="20" height="14" rx="4" fill="#fff" fill-opacity=".55" />
                    <rect x="416" y="176" width="68" height="8" rx="4" fill="#fff" fill-opacity=".35" />
                    <rect x="416" y="192" width="48" height="8" rx="4" fill="#fff" fill-opacity=".35" />
                    <text x="450" y="242" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#fff" fill-opacity=".85">.NET circuit</text>
                </g>

                <!-- code snippet -->
                <g class="art__code">
                    <rect x="196" y="18" width="190" height="40" rx="10" fill="#0f172a" fill-opacity=".92" />
                    <text x="210" y="43" font-family="JetBrains Mono, monospace" font-size="12" fill="#e2e8f0">&lt;<tspan fill="#c4b5fd">ProductCard</tspan> <tspan fill="#fde68a">@@key</tspan>=.. /&gt;</text>
                </g>
            </svg>
        </div>

        <div class="panel__body">
            <span class="panel__tag">ASP.NET Core · Interactive</span>
            <h2 class="panel__title">Blazor</h2>
            <p class="panel__text">
                A component-based interactive app. The UI is built from reusable Razor components
                and updates live over a SignalR connection, without full page reloads.
            </p>
            <ul class="panel__chips">
                <li>Interactive Server</li>
                <li>Reusable components</li>
                <li>Real-time UI updates</li>
                <li>JWT session</li>
            </ul>
            <span class="panel__cta">
                Open Blazor shop
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
        </div>
    </a>

</section>

<p class="note">
    Both front-ends share the same catalogue, cart, orders and Stripe payments through the ProductShopping API.
</p>
