@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProductShopping.Application.DTOs.Auth
@using ProductShopping.UI.Blazor.Services.Auth
@using ProductShopping.UI.Shared.Contracts

@inject IAuthApiClient AuthApiClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<div class="login-page">
    <div class="container">
        <div class="login-wrapper">
            <h1>Log in</h1>

            <div class="row g-4 align-items-start">
                <div class="col-md-5">
                    <section class="login-panel">
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        <EditForm Model="Input" OnValidSubmit="LoginUser">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" role="alert" />

                            <h2>Use a local account to log in.</h2>
                            <hr />

                            <div class="form-floating mb-3">
                                <InputText id="email"
                                           @bind-Value="Input.Email"
                                           class="form-control"
                                           autocomplete="username"
                                           aria-required="true"
                                           placeholder="name@example.com" />
                                <label for="email" class="form-label">Email</label>
                                <ValidationMessage For="() => Input.Email" class="text-danger small d-block mt-1" />
                            </div>

                            <div class="form-floating mb-3">
                                <InputText id="password"
                                           type="password"
                                           @bind-Value="Input.Password"
                                           class="form-control"
                                           autocomplete="current-password"
                                           aria-required="true"
                                           placeholder="password" />
                                <label for="password" class="form-label">Password</label>
                                <ValidationMessage For="() => Input.Password" class="text-danger small d-block mt-1" />
                            </div>

                            <div class="checkbox mb-3">
                                <label class="form-label d-flex align-items-center gap-2">
                                    <InputCheckbox @bind-Value="Input.RememberMe"
                                                   class="form-check-input mt-0" />
                                    <span>Remember me</span>
                                </label>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit"
                                        class="w-100 btn btn-lg btn-primary"
                                        disabled="@isSubmitting">
                                    @(isSubmitting ? "Logging in..." : "Log in")
                                </button>
                            </div>

                            <div class="login-links">
                                <p>
                                    <a href="/forgot-password">Forgot your password?</a>
                                </p>
                                <p>
                                    <a href="/register">Register as a new user</a>
                                </p>
                                <p>
                                    <a href="/resend-email-confirmation">Resend email confirmation</a>
                                </p>
                            </div>
                        </EditForm>
                    </section>
                </div>

                <div class="col-md-6 offset-md-1">
                    <section class="login-panel login-panel--soft">
                        <h3>Use another service to log in.</h3>
                        <hr />
                        <p class="text-muted mb-3">
                            External login providers can be added here later without changing the layout of this page.
                        </p>

                        <div class="external-login-placeholder">
                            <button type="button" class="btn btn-outline-secondary w-100 mb-2" disabled>
                                Google
                            </button>
                            <button type="button" class="btn btn-outline-secondary w-100" disabled>
                                Microsoft
                            </button>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private bool isSubmitting;

    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task LoginUser()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var result = await AuthApiClient.LoginAsync(new LoginUserDto
            {
                Email = Input.Email,
                Password = Input.Password
            });

            var jwtAuthStateProvider = (JwtAuthenticationStateProvider)AuthenticationStateProvider;
            await jwtAuthStateProvider.MarkUserAsAuthenticatedAsync(result);

            NavigationManager.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Error: Invalid login attempt.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}