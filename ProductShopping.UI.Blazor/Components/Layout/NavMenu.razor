@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using ProductShopping.Application.Models.Paging
@using ProductShopping.UI.Blazor.Contracts
@using ProductShopping.UI.Blazor.Handlers
@using ProductShopping.UI.Blazor.Services
@using System.Security.Claims
@using ProductShopping.UI.Shared.Contracts
@using System.Text.Json

@inject NavigationManager NavigationManager
@inject ICartsApiClient CartsApiClient
@inject JwtAuthenticationStateProvider JwtAuthenticationStateProvider
@inject ITokenStore TokenStore
@inject CartState CartState
@implements IDisposable

<nav class="shop-topbar">
    <div class="shop-topbar__inner">
<NavLink href="/" class="shop-brand-link" Match="NavLinkMatch.All">
    <span class="shop-brand-link__eyebrow">Store</span>
    <span class="shop-brand-link__wordmark">
        <span class="shop-brand-link__primary">Product</span><span class="shop-brand-link__accent">Shopping</span>
    </span>
</NavLink>

        <div class="shop-actions">
            <NavLink href="/cart" class="cart-indicator cart-indicator--link" ActiveClass="is-active">
                <span class="cart-indicator__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="20" r="1.6"></circle>
                        <circle cx="18" cy="20" r="1.6"></circle>
                        <path d="M3 4h2l2.2 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.7L21 8H7"></path>
                    </svg>
                </span>
                <span class="cart-indicator__label">Cart</span>

                @if (CartState.ItemsCount > 0)
                {
                    <span class="cart-indicator__badge">@CartState.ItemsCount</span>
                }
            </NavLink>

            <NavLink href="/orders" class="header-action-link" ActiveClass="is-active">
                Orders
            </NavLink>

            <AuthorizeView>
                <Authorized Context="authState">
                    @{
                        var user = authState.User;
                        var email =
                        user.FindFirst(ClaimTypes.Email)?.Value
                        ?? user.FindFirst("email")?.Value
                        ?? user.Identity?.Name
                        ?? "user";
                    }

                    <div class="account-indicator">
                        <div class="account-indicator__avatar" aria-hidden="true">
                            @email[..1].ToUpper()
                        </div>

                        <div class="account-indicator__meta">
                            <span class="account-indicator__label">Signed in as</span>
                            <strong class="account-indicator__email">@email</strong>
                        </div>
                    </div>

                    <button type="button" class="logout-btn" @onclick="LogoutAsync">
                        Logout
                    </button>
                </Authorized>

                <NotAuthorized>
                    <div class="guest-actions">
                        <a href="/login" class="login-btn">Login</a>
                        <a href="/register" class="register-btn">Register</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private AuthenticationState? authState;

    protected override async Task OnInitializedAsync()
    {
        CartState.Changed += OnCartStateChanged;
        JwtAuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        authState = await JwtAuthenticationStateProvider.GetAuthenticationStateAsync();
        await LoadCartItemsCountAsync();
    }

    private async Task LoadCartItemsCountAsync()
    {
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            CartState.Clear();
            return;
        }

        try
        {
            var rawTokenResponse = await TokenStore.GetAccessTokenAsync();

            if (string.IsNullOrWhiteSpace(rawTokenResponse))
            {
                CartState.Clear();
                return;
            }

            var tokenResult = JsonSerializer.Deserialize<AccessTokenResponse>(rawTokenResponse);

            if (tokenResult is null || !tokenResult.isSuccess || string.IsNullOrWhiteSpace(tokenResult.value))
            {
                CartState.Clear();
                return;
            }

            var result = await CartsApiClient.GetCartItemsAsync(
                tokenResult.value,
                new PaginationParameters
                {
                    PageNumber = 1,
                    PageSize = 1000
                });

            CartState.SetItemsCount(result?.Data?.Sum(x => x.Quantity) ?? 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not load cart items count: {ex.Message}");
        }
    }

    // Wywoływane przez Products/Cart (CartState.Changed) — odśwież licznik w pasku.
    private void OnCartStateChanged() => _ = InvokeAsync(StateHasChanged);

    // Po zalogowaniu / wylogowaniu pobierz licznik ponownie.
    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            authState = await task;
            await LoadCartItemsCountAsync();
            StateHasChanged();
        });
    }

    private async Task LogoutAsync()
    {
        var jwtAuthStateProvider = (JwtAuthenticationStateProvider)JwtAuthenticationStateProvider;
        await jwtAuthStateProvider.MarkUserAsLoggedOutAsync();

        CartState.Clear();
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        CartState.Changed -= OnCartStateChanged;
        JwtAuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
