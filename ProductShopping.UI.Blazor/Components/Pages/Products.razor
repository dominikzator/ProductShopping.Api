@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components
@using ProductShopping.Application.Features.CartItem.Commands.AddCartItem
@using ProductShopping.UI.Blazor.Contracts
@using ProductShopping.UI.Blazor.Services
@using ProductShopping.UI.Shared.Clients
@using ProductShopping.UI.Shared.Contracts
@using ProductShopping.UI.Shared.DTOs.Products
@using ProductShopping.UI.Shared.Pagination
@using System.Text.Json

@inject IProductsApiClient ProductsApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ITokenStore TokenStore
@inject ICartsApiClient CartsApiClient
@inject CartState CartState

<PageTitle>Products</PageTitle>

<section class="products-page">
    <header class="products-header">
        <div>
            <p class="products-eyebrow">Catalog</p>
            <h1 class="products-title">Products</h1>
            <p class="products-subtitle">
                Search, filter and sort products just like in the Razor Pages version.
            </p>
        </div>
    </header>

    <section class="filters-toolbar">
        <div class="search-box">
            <input class="search-input"
                   placeholder="Search by product name..."
                   @bind="filterState.Search" />
            <button type="button" class="search-button" @onclick="ApplyFiltersAsync">Search</button>
        </div>

        <div class="filter-grid">
            <div class="filter-group">
                <label>Category</label>
                <select class="filter-input" @bind="filterState.CategoryName">
                    <option value="">All categories</option>
                    @foreach (var category in categoryNames)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Min price</label>
                <input class="filter-input" type="number" step="50" min="0" @bind="filterState.MinPrice" />
            </div>

            <div class="filter-group">
                <label>Max price</label>
                <input class="filter-input" type="number" step="50" min="0" @bind="filterState.MaxPrice" />
            </div>

            <div class="filter-group">
                <label>Min rating</label>
                <input class="filter-input" type="number" step="0.1" min="1" max="5" @bind="filterState.MinRating" />
            </div>

            <div class="filter-group">
                <label>Max rating</label>
                <input class="filter-input" type="number" step="0.1" min="1" max="5" @bind="filterState.MaxRating" />
            </div>

            <div class="filter-group">
                <label>Sort by</label>
                <select class="filter-input" @bind="filterState.SortBy">
                    <option value="">Default</option>
                    <option value="name">Name</option>
                    <option value="price">Price</option>
                    <option value="rating">Rating</option>
                    <option value="category">Category</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Page size</label>
                <select class="filter-input" @bind="filterState.PageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                </select>
            </div>

            <div class="filter-group filter-group--checkbox">
                <label>Descending</label>
                <InputCheckbox @bind-Value="filterState.SortDescending" class="form-check-input" />
            </div>
        </div>

        <div class="filter-actions">
            <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync">Apply filters</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Clear</button>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="products-summary products-summary--loading" aria-hidden="true">
            <span class="skeleton skeleton--text"></span>
            <span class="skeleton skeleton--text skeleton--short"></span>
        </div>

        <div class="products-grid" aria-busy="true" aria-label="Loading products">
            @for (var i = 0; i < SkeletonCount; i++)
            {
                <div class="product-card product-card--skeleton" aria-hidden="true">
                    <div class="product-card__image-wrap">
                        <span class="product-card__image-placeholder"></span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__meta">
                            <span class="skeleton skeleton--chip"></span>
                            <span class="skeleton skeleton--chip skeleton--tiny"></span>
                        </div>
                        <span class="skeleton skeleton--title"></span>
                        <span class="skeleton skeleton--title skeleton--short"></span>
                        <div class="product-card__price-row">
                            <span class="skeleton skeleton--chip"></span>
                            <span class="skeleton skeleton--price"></span>
                        </div>
                        <span class="skeleton skeleton--button"></span>
                    </div>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    else if (products?.Data is null || !products.Data.Any())
    {
        <div class="products-state">No products found for the selected filters.</div>
    }
    else
    {
        <div class="products-summary">
            <span>@products.Metadata.TotalCount products found</span>
            <span>Page @products.Metadata.CurrentPage of @products.Metadata.TotalPages </span>
        </div>

        <div class="products-grid">
            @foreach (var product in products.Data)
            {
                <article class="product-card" @key="product.Id">
                    <div class="product-card__image-wrap">
                        @* Placeholder z animacją widoczny, dopóki obrazek się nie wczyta.
                           Klasę is-loaded dodaje przeglądarka (onload/onerror), bez round-tripu do serwera;
                           @key wymusza nowy <img> dla każdego produktu, więc animacja startuje od nowa po zmianie strony. *@
                        <span class="product-card__image-placeholder" aria-hidden="true"></span>
                        <img src="@product.ImageUrl"
                             alt="@product.Name"
                             class="product-card__image"
                             decoding="async"
                             onload="this.parentElement.classList.add('is-loaded')"
                             onerror="this.parentElement.classList.add('is-loaded', 'is-error')" />
                    </div>

                    <div class="product-card__body">
                        <div class="product-card__meta">
                            <span class="product-card__category">@product.CategoryName</span>
                            <span class="product-card__rating" title="Rating @product.Rating.ToString("0.0") / 5">★ @product.Rating.ToString("0.0")</span>
                        </div>

                        <div class="product-card__title-panel">
                            <h3 class="product-card__title">@product.Name</h3>
                        </div>

                        <div class="product-card__price-row">
                            <span class="product-card__price-label">Price</span>
                            <span class="product-card__price">@product.Price.ToString("0.00") zł</span>
                        </div>

                        <div class="product-card__actions">
                            <div class="quantity-selector">
                                <button type="button" class="quantity-btn" @onclick="() => DecreaseQuantity(product.Id)">-</button>
                                <span class="quantity-value">@GetQuantity(product.Id)</span>
                                <button type="button" class="quantity-btn" @onclick="() => IncreaseQuantity(product.Id)">+</button>
                            </div>

                            <button type="button" class="add-cart-btn" @onclick="() => AddToCartAsync(product.Id)">
                                Add to cart
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>

        <nav class="pagination" aria-label="Products pagination">
            <button type="button"
                    class="pagination-link"
                    disabled="@(products.Metadata.CurrentPage <= 1)"
                    @onclick="() => ChangePageAsync(products.Metadata.CurrentPage - 1)">
                Previous
            </button>

            <span class="pagination-status">
                Page @products.Metadata.CurrentPage / @products.Metadata.TotalPages
            </span>

            <button type="button"
                    class="pagination-link"
                    disabled="@(products.Metadata.CurrentPage >= products.Metadata.TotalPages)"
                    @onclick="() => ChangePageAsync(products.Metadata.CurrentPage + 1)">
                Next
            </button>
        </nav>
    }
</section>

@code {
    private bool isLoading;

    // Liczba szkieletów kart podczas ładowania (maks. 10, żeby nie rysować 50 naraz).
    private int SkeletonCount => Math.Clamp(filterState.PageSize, 1, 10);
    private string? errorMessage;

    private ProductsPageState filterState = new();

    private PagedResultDto<ProductListItemDto>? products;

    private IReadOnlyList<string> categoryNames = Array.Empty<string>();

    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? CategoryName { get; set; }
    [SupplyParameterFromQuery] public decimal? MinPrice { get; set; }
    [SupplyParameterFromQuery] public decimal? MaxPrice { get; set; }
    [SupplyParameterFromQuery] public decimal? MinRating { get; set; }
    [SupplyParameterFromQuery] public decimal? MaxRating { get; set; }
    [SupplyParameterFromQuery] public string? SortBy { get; set; }
    [SupplyParameterFromQuery] public bool? SortDescending { get; set; }
    [SupplyParameterFromQuery] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery] public int? PageSize { get; set; }

    private readonly Dictionary<int, int> productQuantities = new();

    private int GetQuantity(int productId)
    {
        if (!productQuantities.TryGetValue(productId, out var quantity))
        {
            quantity = 1;
            productQuantities[productId] = quantity;
        }

        return quantity;
    }

    private void IncreaseQuantity(int productId)
    {
        productQuantities[productId] = GetQuantity(productId) + 1;
    }

    private void DecreaseQuantity(int productId)
    {
        var current = GetQuantity(productId);

        if (current > 1)
        {
            productQuantities[productId] = current - 1;
        }
    }

    private async Task AddToCartAsync(int productId)
    {
        var rawTokenResponse = await TokenStore.GetAccessTokenAsync();

        if (string.IsNullOrWhiteSpace(rawTokenResponse))
            return;

        var tokenResult = JsonSerializer.Deserialize<AccessTokenResponse>(rawTokenResponse);

        if (tokenResult is null || !tokenResult.isSuccess || string.IsNullOrWhiteSpace(tokenResult.value))
            return;

        var quantity = GetQuantity(productId);

        try
        {
            await CartsApiClient.AddCartItemAsync(
                tokenResult.value,
                new AddCartItemCommand
                {
                    ProductId = productId,
                    Quantity = quantity
                });

            // API dodało dokładnie "quantity" sztuk — zaktualizuj licznik w górnym pasku.
            CartState.ChangeItemsCount(quantity);
            productQuantities[productId] = 1;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Add to cart failed: {ex.StatusCode} {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        categoryNames = await ProductsApiClient.GetCategoryNamesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine("OnParametersSetAsync fired");

        filterState = new ProductsPageState
        {
            Search = Search,
            CategoryName = CategoryName,
            MinPrice = MinPrice,
            MaxPrice = MaxPrice,
            MinRating = MinRating,
            MaxRating = MaxRating,
            SortBy = SortBy,
            SortDescending = SortDescending ?? false,
            PageNumber = PageNumber ?? 1,
            PageSize = PageSize ?? 10
        };

        if (filterState.MinRating.HasValue)
            filterState.MinRating = Math.Clamp(filterState.MinRating.Value, 1m, 5m);

        if (filterState.MaxRating.HasValue)
            filterState.MaxRating = Math.Clamp(filterState.MaxRating.Value, 1m, 5m);

        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        Console.WriteLine("LoadProductsAsync start");
        isLoading = true;
        errorMessage = null;

        try
        {
            var query = new ProductsQueryDto
            {
                Search = filterState.Search,
                CategoryName = filterState.CategoryName,
                MinPrice = filterState.MinPrice,
                MaxPrice = filterState.MaxPrice,
                MinRating = filterState.MinRating,
                MaxRating = filterState.MaxRating,
                SortBy = filterState.SortBy,
                SortDescending = filterState.SortDescending,
                PageNumber = filterState.PageNumber,
                PageSize = filterState.PageSize
            };

            products = await ProductsApiClient.GetProductsAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePageAsync(int page)
    {
        await JS.InvokeVoidAsync("uiHelpers.blurActiveElement");
        filterState.PageNumber = page;
        await LoadProductsAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        await JS.InvokeVoidAsync("uiHelpers.blurActiveElement");
        filterState.PageNumber = 1;
        await LoadProductsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        await JS.InvokeVoidAsync("uiHelpers.blurActiveElement");
        filterState = new ProductsPageState();
        await LoadProductsAsync();
    }

    private async Task UpdateUrlAsync()
    {
        var query = new Dictionary<string, object?>();

        if (!string.IsNullOrWhiteSpace(filterState.Search))
            query["search"] = filterState.Search;

        if (!string.IsNullOrWhiteSpace(filterState.CategoryName))
            query["categoryName"] = filterState.CategoryName;

        if (filterState.MinPrice.HasValue)
            query["minPrice"] = filterState.MinPrice;

        if (filterState.MaxPrice.HasValue)
            query["maxPrice"] = filterState.MaxPrice;

        if (filterState.MinRating.HasValue)
            query["minRating"] = filterState.MinRating;

        if (filterState.MaxRating.HasValue)
            query["maxRating"] = filterState.MaxRating;

        if (!string.IsNullOrWhiteSpace(filterState.SortBy))
            query["sortBy"] = filterState.SortBy;

        if (filterState.SortDescending)
            query["sortDescending"] = filterState.SortDescending;

        query["pageNumber"] = filterState.PageNumber;
        query["pageSize"] = filterState.PageSize;

        var uri = NavigationManager.GetUriWithQueryParameters("/", query);

        await JS.InvokeVoidAsync("window.history.replaceState", null, "", uri);
    }

    private sealed class ProductsPageState
    {
        public int PageNumber { get; set; } = 1;
        public int PageSize { get; set; } = 10;
        public string? Search { get; set; }
        public string? CategoryName { get; set; }
        public decimal? MinPrice { get; set; }
        public decimal? MaxPrice { get; set; }
        public decimal? MinRating { get; set; }
        public decimal? MaxRating { get; set; }
        public string? SortBy { get; set; }
        public bool SortDescending { get; set; }
    }
}