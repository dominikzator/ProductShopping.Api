@page "/OrderPayment/success"

@using ProductShopping.Application.Features.Order.Queries.GetOrderDetails
@using ProductShopping.UI.Blazor.Services
@using ProductShopping.UI.Shared.Contracts
@using ProductShopping.UI.Shared.DTOs.Payments

@inject IPaymentsApiClient PaymentsApiClient
@inject IOrdersApiClient OrdersApiClient
@inject OrderPaymentService OrderPaymentService

<PageTitle>Payment successful</PageTitle>

<div class="payment-page">
    @if (IsLoading)
    {
        <div class="payment-loading" aria-busy="true">
            <span class="payment-loading__spinner" aria-hidden="true"></span>
            <span>Checking your payment…</span>
        </div>
    }
    else if (Session is null)
    {
        <PaymentHero Tone="warning" Title="We could not verify your payment">
            <ChildContent>
                <p>@(ErrorMessage ?? "The payment link is missing or has expired.") You can check the payment status on your orders page.</p>
            </ChildContent>
            <Actions>
                <a href="/orders" class="payment-btn payment-btn--primary">Go to my orders</a>
                <a href="/" class="payment-btn payment-btn--ghost">Continue shopping</a>
            </Actions>
        </PaymentHero>
    }
    else if (!Session.IsPaid)
    {
        <PaymentHero Tone="warning" Title="Your payment is being processed">
            <ChildContent>
                <p>
                    Stripe has not confirmed the payment yet@(Order is not null ? " for order " : "")<strong>@Order?.OrderNumber</strong>.
                    This usually takes a moment — check your orders page in a few minutes.
                </p>
            </ChildContent>
            <Actions>
                <a href="/orders" class="payment-btn payment-btn--primary">Go to my orders</a>
                <a href="/" class="payment-btn payment-btn--ghost">Continue shopping</a>
            </Actions>
        </PaymentHero>
    }
    else
    {
        <PaymentHero Tone="success" Title="Payment completed successfully">
            <ChildContent>
                <p>
                    Thank you for your order@(Order is not null ? " " : "")<strong>@Order?.OrderNumber</strong>.
                    We received <strong>@Session.Amount.ToString("0.00") @CurrencyLabel</strong> and your order is now being processed.
                </p>
            </ChildContent>
            <Actions>
                <a href="/orders" class="payment-btn payment-btn--primary">View my orders</a>
                <a href="/" class="payment-btn payment-btn--ghost">Continue shopping</a>
            </Actions>
        </PaymentHero>
    }

    @if (!IsLoading && Order is not null)
    {
        <OrderPaymentDetails Order="Order"
                             PaymentLabel="@(Session?.IsPaid == true ? "Paid" : "Processing")"
                             PaymentTone="@(Session?.IsPaid == true ? "paid" : "pending")" />
    }
    else if (!IsLoading && Session is not null && !IsAuthenticated)
    {
        <p class="payment-note">
            <a href="/login">Log in</a> to see the details of your order.
        </p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    private string? SessionId { get; set; }

    private PaymentSessionStatusDto? Session;
    private OrderDto? Order;
    private bool IsLoading = true;
    private bool IsAuthenticated;
    private string? ErrorMessage;

    private string CurrencyLabel => Session?.Currency?.ToLowerInvariant() switch
    {
        null or "" or "pln" => "zł",
        var c => c.ToUpperInvariant()
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(SessionId))
                return;

            Session = await PaymentsApiClient.GetPaymentSessionStatusAsync(SessionId);

            var token = await OrderPaymentService.GetAccessTokenAsync();
            IsAuthenticated = token is not null;

            if (token is not null && Session?.OrderIdValue is int orderId)
                Order = await OrdersApiClient.GetOrderAsync(token, orderId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            ErrorMessage = Session is null ? "Something went wrong while checking the payment." : null;
            Console.WriteLine($"OrderPaymentSuccess: {ex}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
