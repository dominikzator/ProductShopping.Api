@page "/OrderPayment/success"
@model ProductShopping.UI.RazorPagesUI.Pages.OrderPaymentSuccessModel
@{
    ViewData["Title"] = "Payment Success";
}

<section class="order-success-page">
    <div class="order-success-hero">
        <div class="order-success-icon">✓</div>
        <div>
            <h1 class="order-success-title">Payment completed successfully</h1>
            <p class="order-success-subtitle">
                Thank you for your order. Your payment has been received and your order is now being processed.
            </p>
        </div>
    </div>

    @if (Model.Order is not null)
    {
        <div class="order-success-grid">
            <div class="order-success-card">
                <h2>Order summary</h2>
                <div class="order-success-meta">
                    <div class="meta-row">
                        <span>Order number</span>
                        <strong>@Model.Order.OrderNumber</strong>
                    </div>
                    <div class="meta-row">
                        <span>Payment status</span>
                        <strong class="text-success">Paid</strong>
                    </div>
                    <div class="meta-row">
                        <span>Total</span>
                        <strong>
                            @Model.Order.OrderItems.Sum(x => x.TotalPrice).ToString("0.00") zł
                        </strong>
                    </div>
                </div>
            </div>

            <div class="order-success-card">
                <h2>Shipping address</h2>
                <div class="order-address">
                    <p>@Model.Order.Street @Model.Order.BuildingNumber/@Model.Order.ApartmentNumber</p>
                    <p>@Model.Order.PostalCode @Model.Order.City</p>
                    <p>@Model.Order.Country</p>
                    <p>@Model.Order.PhoneNumber</p>
                </div>
            </div>
        </div>

        <div class="order-success-card order-success-items">
            <h2>Ordered items</h2>

            <div class="order-items-list">
                @foreach (var item in Model.Order.OrderItems)
                {
                    <div class="order-item-row">
                        <div class="order-item-main">
                            <div class="order-item-name">@item.ProductName</div>
                            <div class="order-item-details">
                                Quantity: @item.Quantity
                            </div>
                        </div>
                        <div class="order-item-pricing">
                            <div>@item.UnitPrice.ToString("0.00") zł</div>
                            <strong>@item.TotalPrice.ToString("0.00") zł</strong>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="order-success-card order-success-summary">
            <h2>Summary</h2>
            <div class="meta-row">
                <span>Total</span>
                <strong class="order-total">
                    @Model.Order.OrderItems.Sum(x => x.TotalPrice).ToString("0.00") zł
                </strong>
            </div>
        </div>
    }
</section>