@page "/Orders"
@model ProductShopping.UI.RazorPagesUI.Pages.OrdersModel
@{
    ViewData["Title"] = "Orders history";
}

<section class="products-page">
    <header class="products-header">
        <p class="products-eyebrow">Account</p>
        <h1 class="products-title">Orders history</h1>
        <p class="products-subtitle">
            Here you can review your recent orders, delivery details and item summaries.
        </p>
    </header>

    @if (!Model.Orders.Any())
    {
        <section class="checkout-layout">
            <div class="checkout-form-panel">
                <div class="checkout-form-box">
                    <h2 class="checkout-section-title">No orders yet</h2>
                    <p class="checkout-text">
                        You have not placed any orders yet.
                    </p>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="orders-history">
            @foreach (var order in Model.Orders)
            {
                var orderTotal = order.OrderItems?.Sum(x => x.TotalPrice) ?? 0m;
                var itemsCount = order.OrderItems?.Sum(x => x.Quantity) ?? 0;
                var normalizedStatus = order.OrderStatus?.Trim();
                var isPending = string.Equals(normalizedStatus, "Pending", StringComparison.OrdinalIgnoreCase);
                var isPaid = string.Equals(normalizedStatus, "Paid", StringComparison.OrdinalIgnoreCase)
                || string.Equals(normalizedStatus, "Payed", StringComparison.OrdinalIgnoreCase);

                <article class="order-history-card order-history-card--rich">
                    <div class="order-history-card__header">
                        <div class="order-history-card__header-main">
                            <p class="order-history-card__eyebrow">Order number</p>
                            <h2 class="order-history-card__number">@order.OrderNumber</h2>
                            <p class="order-history-card__meta">
                                Created: @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </p>
                        </div>

                        <div class="order-history-card__header-side">
                            <span class="order-status-badge @Model.GetStatusCssClass(order.OrderStatus)">
                                @order.OrderStatus
                            </span>

                            @if (isPending)
                            {
                                <form method="post" asp-page-handler="CompletePayment">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="order-pay-btn">
                                        Complete payment
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="order-history-card__summary">
                        <div class="order-summary-box order-summary-box--rich">
                            <span class="order-summary-box__label">Items</span>
                            <strong class="order-summary-box__value">@itemsCount</strong>
                        </div>

                        <div class="order-summary-box order-summary-box--rich">
                            <span class="order-summary-box__label">Products</span>
                            <strong class="order-summary-box__value">@(order.OrderItems?.Count ?? 0)</strong>
                        </div>

                        <div class="order-summary-box order-summary-box--rich">
                            <span class="order-summary-box__label">Total</span>
                            <strong class="order-summary-box__value">@orderTotal.ToString("0.00") zł</strong>
                        </div>

                        <div class="order-summary-box order-summary-box--rich">
                            <span class="order-summary-box__label">Updated</span>
                            <strong class="order-summary-box__value">@order.UpdatedAt.ToString("dd.MM.yyyy")</strong>
                        </div>
                    </div>

                    <div class="order-history-card__body">
                        <section class="order-history-card__section order-history-card__section--soft">
                            <h3 class="order-history-card__section-title">Delivery details</h3>
                            <div class="order-address">
                                <p>
                                    @order.Street @order.BuildingNumber
                                    @if (!string.IsNullOrWhiteSpace(order.ApartmentNumber))
                                    {
                                        <span>/@order.ApartmentNumber</span>
                                    }
                                </p>
                                <p>@order.PostalCode @order.City</p>
                                <p>@order.Country</p>

                                @if (!string.IsNullOrWhiteSpace(order.PhoneNumber))
                                {
                                    <p>Phone: @order.PhoneNumber</p>
                                }
                            </div>
                        </section>

                        <section class="order-history-card__section order-history-card__section--soft">
                            <h3 class="order-history-card__section-title">Items summary</h3>

                            <div class="order-items-list">
                                @if (order.OrderItems is not null && order.OrderItems.Any())
                                {
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <div class="order-item-row order-item-row--rich">
                                            <div class="order-item-row__main">
                                                <p class="order-item-row__name">
                                                    @(string.IsNullOrWhiteSpace(item.ProductName) ? $"Product #{item.ProductId}" : item.ProductName)
                                                </p>
                                                <p class="order-item-row__meta">
                                                    Quantity: @item.Quantity · Unit price: @item.UnitPrice.ToString("0.00") zł
                                                </p>
                                            </div>

                                            <div class="order-item-row__price">
                                                @item.TotalPrice.ToString("0.00") zł
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="order-history-card__empty">No order items found.</p>
                                }
                            </div>
                        </section>
                    </div>
                </article>
            }
        </section>

        <nav class="orders-pagination" aria-label="Orders pagination">
            <a asp-page="/Orders"
               asp-route-PageNumber="@(Model.PageNumber - 1)"
               asp-route-PageSize="@Model.PageSize"
               class="orders-pagination__btn @(Model.HasPreviousPage ? "" : "orders-pagination__btn--disabled")"
               aria-disabled="@(!Model.HasPreviousPage)"
               tabindex="@(Model.HasPreviousPage ? "0" : "-1")">
                Previous
            </a>

            <div class="orders-pagination__pages">
                @foreach (var pageNumber in Model.GetVisiblePages())
                {
                    <a asp-page="/Orders"
                       asp-route-PageNumber="@pageNumber"
                       asp-route-PageSize="@Model.PageSize"
                       class="orders-pagination__page @(pageNumber == Model.PageNumber ? "orders-pagination__page--active" : "")">
                        @pageNumber
                    </a>
                }
            </div>

            <a asp-page="/Orders"
               asp-route-PageNumber="@(Model.PageNumber + 1)"
               asp-route-PageSize="@Model.PageSize"
               class="orders-pagination__btn @(Model.HasNextPage ? "" : "orders-pagination__btn--disabled")"
               aria-disabled="@(!Model.HasNextPage)"
               tabindex="@(Model.HasNextPage ? "0" : "-1")">
                Next
            </a>
        </nav>
    }
</section>